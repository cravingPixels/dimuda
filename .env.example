## host
TZ=Europe/Rome
APP_DIR=/mnt/pool/dimuda               # this stack's root dataset; ${APP_DIR}/data must be writable by uid 65532

## network
DOMAIN=example.com

## dimuda
DIMUDA_NAME=dimuda
DIMUDA_SUBDOMAIN=dimuda                     # results in dimuda.example.com
DIMUDA_VERSION=latest
DIMUDA_SCAN_INTERVAL=6h

## compose sources (mounted read-only)
DOCKGE_STACKS_DIR=/opt/stacks
KOMODO_STACKS_DIR=/etc/komodo/stacks
GIT_REPOS=stacks=https://github.com/cravingPixels/docker-compose-stacks.git

## ntfy notifications (upstream releases only)
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=dimuda

## secrets — never commit real values
GIT_TOKEN=changeme                            # fine-grained PAT, Contents: read, for private GIT_REPOS
GITHUB_TOKEN=changeme                         # any PAT; raises GitHub API limit from 60 to 5000 req/h for changelogs
NTFY_TOKEN=changeme                           # ntfy auth token
